# --- Supabase ---
# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Project Settings -> API Keys -> service_role (RAHASIA, server-side only)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Login dashboard ---
# Password untuk masuk ke dashboard
APP_PASSWORD=ganti-dengan-password-kuat
# String acak panjang untuk menandatangani cookie sesi
AUTH_SECRET=ganti-dengan-string-acak-panjang

# --- Telegram ---
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Secret token webhook (string acak buatanmu, didaftarkan saat setWebhook)
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak
# Chat ID kamu. Hanya ID di sini yang boleh menulis data. Pisahkan dengan koma.
TELEGRAM_ALLOWED_CHAT_IDS=123456789
